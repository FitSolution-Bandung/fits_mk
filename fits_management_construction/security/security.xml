<odoo>
    <data>
        <record id="module_category_management_construction" model="ir.module.category">
            <field name="name">Management Construction</field>
            <field name="sequence">10</field>
        </record>

        <record id="privilege_management_construction" model="res.groups.privilege">
            <field name="name">Management Construction</field>
            <field name="category_id" ref="module_category_management_construction"/>
        </record>

        <record id="group_management_construction_owner" model="res.groups">
            <field name="name">Owner</field>
            <field name="privilege_id" ref="privilege_management_construction"/>
        </record>

        <record id="group_management_construction_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="privilege_management_construction"/>
            <field name="implied_ids" eval="[Command.link(ref('group_management_construction_owner'))]"/>
        </record>

        <record id="group_management_construction_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="privilege_management_construction"/>
            <field name="implied_ids" eval="[Command.link(ref('group_management_construction_user'))]"/>
            <field name="user_ids" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
